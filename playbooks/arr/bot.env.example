# Managed by ARR_TELEGRAM_BOT_TOKEN in external_vars.yml when defined.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Empty allows ANY user in private chats.
TELEGRAM_ALLOWED_USERS=
# Only these users may permanently delete media. Does not restrict download requests or /list.
# Empty falls back to TELEGRAM_ALLOWED_USERS; both empty disables permanent deletion.
TELEGRAM_CLEANUP_USERS=
# Filled automatically by configure.yaml from the running apps.
RADARR_API_KEY=
SONARR_API_KEY=
# Managed 1080p profile IDs, also filled automatically by configure.yaml.
RADARR_QUALITY_PROFILE_ID=
SONARR_QUALITY_PROFILE_ID=
# Optional language support; configure.yaml fills ALL of these together.
RADARR_RU_PROFILE_ID=
SONARR_RU_PROFILE_ID=
BAZARR_URL=
BAZARR_API_KEY=
BAZARR_EN_PROFILE_ID=
BAZARR_RU_PROFILE_ID=
