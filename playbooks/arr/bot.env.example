# Managed by ARR_TELEGRAM_BOT_TOKEN in external_vars.yml when defined.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Empty allows ANY user in private chats.
TELEGRAM_ALLOWED_USERS=
# Filled automatically by configure.yaml from the running apps.
RADARR_API_KEY=
SONARR_API_KEY=
# Managed 1080p profile IDs, also filled automatically by configure.yaml.
RADARR_QUALITY_PROFILE_ID=
SONARR_QUALITY_PROFILE_ID=
