{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "network": "udp",
        "action": "route",
        "outbound": "vless-nt1"
      },
      {
        "action": "sniff"
      },
      {
        "domain_suffix": [
          ".ru",
          ".su",
          ".\u0440\u0444"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "geoip-ru",
        "action": "route",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geoip-ru",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-ru.srs",
        "update_interval": "1d"
      }
    ],
    "final": "vless-nt1"
  }
}
