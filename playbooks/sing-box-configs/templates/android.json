{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "bootstrap"
      },
      {
        "type": "tcp",
        "tag": "proxied-dns",
        "server": "1.1.1.1",
        "detour": "proxy"
      }
    ],
    "final": "proxied-dns",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "bootstrap",
      "strategy": "ipv4_only"
    },
    "rules": [
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "network": "udp",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "action": "sniff"
      },
      {
        "domain_suffix": [
          ".ru",
          ".su",
          ".\u0440\u0444"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "geoip-ru",
        "action": "route",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geoip-ru",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-ru.srs",
        "update_interval": "1d"
      }
    ],
    "final": "proxy"
  }
}
