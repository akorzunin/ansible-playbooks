# Public defaults; credentials come from external_vars.yml, not a controller-local .env.
TZ=Europe/Moscow
GF_PATHS_CONFIG=/etc/grafana/grafana.ini
GF_PATHS_DATA=/var/lib/grafana
GF_PATHS_HOME=/usr/share/grafana
GF_PATHS_LOGS=/var/log/grafana
GF_PATHS_PLUGINS=/var/lib/grafana/plugins
GF_PATHS_PROVISIONING=/etc/grafana/provisioning
# JSON quoting handles special characters; $$ prevents Compose interpolation of secrets.
GF_SECURITY_ADMIN_USER={{ monitoring_grafana_admin_user | to_json(ensure_ascii=False) | replace('$', '$$') }}
GF_SECURITY_ADMIN_PASSWORD={{ monitoring_grafana_admin_password | to_json(ensure_ascii=False) | replace('$', '$$') }}
GF_USERS_ALLOW_SIGN_UP=false
GF_SMTP_ENABLED=false
GF_SERVER_ROOT_URL=https://grafana.akorz.duckdns.org/
HTTP_PROXY=host.docker.internal:20171
HTTPS_PROXY=host.docker.internal:20171
NO_PROXY=localhost,127.0.0.1,prometheus,loki
