{
  "uid": "monitoring-containers",
  "title": "Containers",
  "description": "Container metrics for inventory-managed nodes. CPU is measured in cores, not divided by CPUs on unrelated hosts.",
  "tags": ["monitoring", "ansible"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [{
      "name": "node",
      "label": "Node",
      "type": "query",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "query": {"query": "label_values(up{job=\"cadvisor\"}, node)", "refId": "StandardVariableQuery"},
      "definition": "label_values(up{job=\"cadvisor\"}, node)",
      "refresh": 1,
      "sort": 1,
      "multi": true,
      "includeAll": true,
      "allValue": ".*",
      "current": {"text": "All", "value": "$__all"},
      "options": []
    }]
  },
  "panels": [
    {
      "id": 1, "title": "cAdvisor availability", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "up{job=\"cadvisor\", node=~\"$node\"}", "instant": true, "range": false, "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {
        "min": 0, "max": 1,
        "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "title": "Container CPU (cores)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"refId": "A", "expr": "sum by (node, name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\", node=~\"$node\", image!=\"\", name!=\"\"}[$__rate_interval]))", "legendFormat": "{{node}} / {{name}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 3, "title": "Container memory (working set)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"refId": "A", "expr": "sum by (node, name) (container_memory_working_set_bytes{job=\"cadvisor\", node=~\"$node\", image!=\"\", name!=\"\"})", "legendFormat": "{{node}} / {{name}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 4, "title": "Container network receive", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [{"refId": "A", "expr": "sum by (node, name) (rate(container_network_receive_bytes_total{job=\"cadvisor\", node=~\"$node\", image!=\"\", name!=\"\"}[$__rate_interval]))", "legendFormat": "{{node}} / {{name}}"}],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 5, "title": "Container network transmit", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [{"refId": "A", "expr": "sum by (node, name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\", node=~\"$node\", image!=\"\", name!=\"\"}[$__rate_interval]))", "legendFormat": "{{node}} / {{name}}"}],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ]
}
