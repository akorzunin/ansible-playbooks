{
  "uid": "monitoring-nodes",
  "title": "Nodes",
  "description": "Inventory-managed nodes. Select one or more nodes; no per-host dashboard copies are needed.",
  "tags": ["monitoring", "ansible"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [{
      "name": "node",
      "label": "Node",
      "type": "query",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "query": {"query": "label_values(up{job=\"nodeexporter\"}, node)", "refId": "StandardVariableQuery"},
      "definition": "label_values(up{job=\"nodeexporter\"}, node)",
      "refresh": 1,
      "sort": 1,
      "multi": true,
      "includeAll": true,
      "allValue": ".*",
      "current": {"text": "All", "value": "$__all"},
      "options": []
    }]
  },
  "panels": [
    {
      "id": 1, "title": "Exporter availability", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "up{job=\"nodeexporter\", node=~\"$node\"}", "instant": true, "range": false, "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {
        "min": 0, "max": 1,
        "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
      }, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "title": "CPU utilization", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg by (node) (rate(node_cpu_seconds_total{job=\"nodeexporter\", mode=\"idle\", node=~\"$node\"}[$__rate_interval])))", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 3, "title": "Memory utilization", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"nodeexporter\", node=~\"$node\"} / node_memory_MemTotal_bytes{job=\"nodeexporter\", node=~\"$node\"})", "legendFormat": "{{node}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 4, "title": "Filesystem utilization", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"nodeexporter\", node=~\"$node\", fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"nodeexporter\", node=~\"$node\", fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{node}} {{mountpoint}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 5, "title": "Network traffic", "type": "timeseries",
      "description": "Interface-sum heuristic: VPN/bridge paths may double-count traffic. Filter to specific uplinks if exact host throughput is needed.",
      "datasource": {"type": "prometheus", "uid": "monitoring-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [
        {"refId": "A", "expr": "sum by (node) (rate(node_network_receive_bytes_total{job=\"nodeexporter\", node=~\"$node\", device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval]))", "legendFormat": "{{node}} receive"},
        {"refId": "B", "expr": "sum by (node) (rate(node_network_transmit_bytes_total{job=\"nodeexporter\", node=~\"$node\", device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval]))", "legendFormat": "{{node}} transmit"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ]
}
