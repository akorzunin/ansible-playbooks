{
    servers :443 {
        listener_wrappers {
            layer4 {
                @vpn_naive tls sni {{ vpn_node_domain }}
                route @vpn_naive {
                    proxy 127.0.0.1:8444
                }
            }
            tls
        }
    }
}

http://{{ vpn_node_domain }} {
    handle /.well-known/acme-challenge/* {
        reverse_proxy 127.0.0.1:8089
    }
    handle {
        redir https://{{ vpn_node_domain }}{uri} permanent
    }
}

