services:
  naive:
    image: vpn-node-naive:2.11.7-naive2
    command: [run, --config, /etc/vpn/Caddyfile, --adapter, caddyfile]
    restart: unless-stopped
    user: "{{ ansible_facts.getent_passwd.vpnproxy[1] }}:{{ ansible_facts.getent_passwd.vpnproxy[2] }}"
    ports:
      - "80:8080"
      - "443:8443"
    environment:
      XDG_DATA_HOME: /var/lib/vpn-node
      XDG_CONFIG_HOME: /var/lib/vpn-node
      GOMEMLIMIT: 48MiB
      GOGC: "50"
      GOMAXPROCS: "2"
    volumes:
      - /srv/deploy/vpn-node/Caddyfile:/etc/vpn/Caddyfile:ro
      - /var/lib/vpn-node:/var/lib/vpn-node:rw
    read_only: true
    tmpfs: ["/tmp:size=16m,mode=1777"]
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: 96m
    pids_limit: 128
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  vless:
    # Upstream sing-box 1.14.4, immutable multi-platform manifest.
    image: ghcr.io/sagernet/sing-box@sha256:0788ffbddab2c68a99a2dd4780bbc50902f159af6f589df3ee74a8389d278279
    command: [run, -c, /etc/vpn/vless.json]
    restart: unless-stopped
    user: "{{ ansible_facts.getent_passwd.vpnproxy[1] }}:{{ ansible_facts.getent_passwd.vpnproxy[2] }}"
    # TCP/443 belongs to Naive; add an SNI router if REALITY also needs port 443.
    ports:
      - "8443:8443"
    volumes:
      - /srv/deploy/vpn-node/vless.json:/etc/vpn/vless.json:ro
    read_only: true
    tmpfs: ["/tmp:size=16m,mode=1777"]
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: 128m
    pids_limit: 128
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
