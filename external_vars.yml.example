DNS_HOME: example.org
DNS_SW1: example.org
DNS_PL1: example.org
HOST_LOCAL_WS_IP: 0.0.0.0
HOST_LOCAL_PI_IP: 0.0.0.0
HOST_SW1_IP: 0.0.0.0
HOST_PL1_IP: 0.0.0.0
AUTH_USER: example
AUTH_PASS: example
V2RAYA_ADMIN_USERNAME: example
V2RAYA_ADMIN_PASSWORD: example
V2RAYA_NODE_URL: "vless://uuid@example.com:443?type=tcp&security=reality&pbk=public-key&sni=example.com&fp=chrome&sid=short-id#node"
ARR_TELEGRAM_BOT_TOKEN: ""
# Store real values as !vault strings in external_vars.yml.
# Uptime Kuma reuses AUTH_PASS and these monitoring Telegram credentials.
MONITORING_TELEGRAM_BOT_TOKEN: ""
MONITORING_TELEGRAM_CHAT_ID: "" # Numeric chat ID; groups usually have negative IDs.
# Existing Grafana org-1 administrator, only needed for one-time UI cleanup.
# These are not necessarily the initial GF_SECURITY_ADMIN_* values in .env.
MONITORING_GRAFANA_ADMIN_USER: ""
MONITORING_GRAFANA_ADMIN_PASSWORD: ""
RUTRACKER_USER: ""
RUTRACKER_PASS: ""
# Disposable Cherry VPN project; restore-keys.yaml loads this into OpenTofu.
CHERRY_PROJECT_ID: 0
# Store as a !vault string containing JSON with admin_private/admin_public and
# probe_private/probe_public. Reuse the same keys across trusted controllers.
CHERRY_VPN_SSH_KEYS: ""
