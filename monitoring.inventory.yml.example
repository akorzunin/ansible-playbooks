---
# Copy to monitoring.inventory.yml (ignored) and configure private source CIDRs.
# Overlay for ./hosts: one entry per machine
all:
  vars:
    monitoring_workstation_allowed_sources: &workstation_scraper_sources
      - 127.0.0.1/32
      - 172.16.0.0/12
      # Documentation-only address; replace with your scraper's egress IP or VPN /32.
      - 198.51.100.5/32
  children:
    monitoring_servers:
      hosts:
        remote_workstation:
    monitored_nodes:
      vars:
        monitoring_enabled: true
        monitoring_availability_alert: false
        monitoring_client_telegraf_port: 9273
      hosts:
        remote_workstation:
          monitoring_node: workstation
          monitoring_telegraf_target: telegraf:9273
          monitoring_gpu_target: nvidia-gpu-exporter:9835
        remote_pi:
          monitoring_node: pi
          # SSH uses the public hostname; metrics are reachable over the LAN.
          monitoring_address: 192.168.1.58
          monitoring_client_telegraf_bind_address: 192.168.1.58
          # Alpine no longer publishes ARMv7 images; the pinned Debian image does.
          monitoring_client_telegraf_image: telegraf:1.40.2
          monitoring_telegraf_allowed_sources:
            - 127.0.0.1/32
            - 172.16.0.0/12
            - 192.168.1.132/32
        nk1:
          monitoring_availability_alert: true
          monitoring_telegraf_allowed_sources: *workstation_scraper_sources
        nt1:
          monitoring_availability_alert: true
          monitoring_telegraf_allowed_sources: *workstation_scraper_sources
    # Retain SSH records in ./hosts, but never scrape or deploy exporters here.
    retired_nodes:
      hosts:
        kr1:
        sw1:
        pl1:
